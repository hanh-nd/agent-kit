{
  "name": "@hanhnd/agent-kit",
  "version": "1.0.38",
  "description": "Agent Kit MCP server for software development agent workflows",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "agent-kit": "dist/server.js",
    "cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanh-nd/agent-kit.git",
    "directory": "mcp"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && npm run bundle",
    "bundle": "esbuild src/entrypoints/server.ts src/entrypoints/cli.ts --bundle --platform=node --format=esm --outdir=dist --external:node:* --external:libsql --external:fastembed --external:node-llama-cpp",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "tsc && node --test $(find dist -name '*.test.js' | tr '\\n' ' ')"
  },
  "dependencies": {
    "node-llama-cpp": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.13.1",
    "dedent": "^1.5.3",
    "fastembed": "^1.14.0",
    "libsql": "^0.5.29",
    "stopword": "^3.1.5",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "esbuild": "^0.25.4",
    "typescript": "^5.8.3"
  }
}
