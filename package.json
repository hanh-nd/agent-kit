{
  "name": "@hanhnd/agent-suite",
  "version": "1.0.0",
  "description": "Marketplace of AI Agents for software development",
  "private": true,
  "workspaces": [
    "mcp",
    "plugins/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "publish:mcp": "npm publish --workspace @hanhnd/agent-kit",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanh-nd/agent-kit.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.4"
  }
}
